# Server only. Never use the VITE_ prefix for database credentials.
# Neon/Vercel currently supplies FORJA_DATABASE_URL; FORJA_URL takes priority if set.
FORJA_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# Optional, used only by scripts/seed-users.mjs. Do not configure these in the frontend.
FORJA_SEED_STUDENT_PASSWORD=
FORJA_SEED_TEACHER_PASSWORD=
# Optional compatibility account. Existing password hashes are never overwritten.
FORJA_SEED_TEACHER2_PASSWORD=
